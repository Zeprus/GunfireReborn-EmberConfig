<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>EmberConfig.PrefabDataGen</RootNamespace>
    <AssemblyName>EmberConfig.PrefabDataGen</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DefaultItemExcludes>$(DefaultItemExcludes);PrefabDataGen.Tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="13.7.0" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>EmberConfig.PrefabDataGen.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
