<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SettingsLib.Tests</RootNamespace>
    <AssemblyName>SettingsLib.Tests</AssemblyName>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>
  </PropertyGroup>

  <PropertyGroup Label="GamePaths">
    <GameDir>E:\SteamLibrary\steamapps\common\Gunfire Reborn</GameDir>
    <BepInExDir>$(GameDir)\BepInEx</BepInExDir>
    <GameLibDir>$(BepInExDir)\interop</GameLibDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SettingsLib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(BepInExDir)\core\*.dll" Exclude="$(BepInExDir)\core\dobby.dll" Private="false" />
    <Reference Include="$(GameLibDir)\*.dll" Exclude="$(GameLibDir)\Newtonsoft.Json.dll" Private="false" />
  </ItemGroup>

  <Target Name="CopyBepInExAndGameAssemblies" AfterTargets="Build">
    <ItemGroup>
      <_BepInExAssembly Include="$(BepInExDir)\core\*.dll" Exclude="$(BepInExDir)\core\dobby.dll" />
      <_GameAssembly Include="$(GameLibDir)\*.dll" Exclude="$(GameLibDir)\Newtonsoft.Json.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_BepInExAssembly)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_GameAssembly)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit" Version="2.8.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
